@model List<Geriatrico.Models.Dominio.Medicamento>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Medicamentos</h2>
        <a asp-action="Agregar" class="btn btn-primary">+ Nuevo Medicamento</a>
    </div>

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success">@TempData["Exito"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    <table class="table table-bordered table-hover">
        <thead class="table-dark">
            <tr>
                <th>Nombre</th>
                <th>Nombre Genérico</th>
                <th>Presentación</th>
                <th>Laboratorio</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var m in Model)
            {
                <tr>
                    <td>@m.Nombre</td>
                    <td>@m.NombreGenerico</td>
                    <td>@m.Presentacion</td>
                    <td>@m.Laboratorio</td>
                    <td>
                        <a asp-action="Modificar" asp-route-id="@m.Id" class="btn btn-sm btn-warning">Editar</a>
                        <a asp-action="Eliminar" asp-route-id="@m.Id" class="btn btn-sm btn-danger"
                           onclick="return confirm('¿Eliminar este medicamento?')">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
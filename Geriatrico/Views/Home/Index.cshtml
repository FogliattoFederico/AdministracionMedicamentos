@model Geriatrico.Models.ViewModels.DashboardViewModel

<div class="container mt-4">
    <h2 class="mb-4">Dashboard</h2>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

 
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card text-white bg-primary">
                <div class="card-body text-center">
                    <h1>@Model.TotalPacientes</h1>
                    <p class="mb-0">Pacientes activos</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-secondary">
                <div class="card-body text-center">
                    <h1>@Model.TotalMedicamentos</h1>
                    <p class="mb-0">Medicamentos</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-success">
                <div class="card-body text-center">
                    <h1>@Model.AdministracionesTomadas</h1>
                    <p class="mb-0">Tomas realizadas hoy</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-danger">
                <div class="card-body text-center">
                    <h1>@Model.AdministracionesPendientes</h1>
                    <p class="mb-0">Tomas pendientes hoy</p>
                </div>
            </div>
        </div>
    </div>

   
    <h4 class="mb-3">Últimos pacientes agregados</h4>
    <table class="table table-bordered table-hover">
        <thead class="table-dark">
            <tr>
                <th>Apellido</th>
                <th>Nombre</th>
                <th>DNI</th>
                <th>Habitación</th>
                <th>Obra Social</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model.UltimosPacientes)
            {
                <tr>
                    <td>@p.Apellido</td>
                    <td>@p.Nombre</td>
                    <td>@p.Dni</td>
                    <td>@p.Habitacion</td>
                    <td>@p.ObraSocial</td>
                    <td>
                        <a asp-controller="Pacientes" asp-action="Detalle" asp-route-id="@p.Id" class="btn btn-sm btn-info">Ver</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
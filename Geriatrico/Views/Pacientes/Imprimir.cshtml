@{
    Layout = null;
}

@model Geriatrico.Models.ViewModels.PacienteDetalleViewModel

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Hoja de Medicación — @Model.Paciente.Apellido, @Model.Paciente.Nombre</title>
    <style>
            body {
                font-family: Arial, sans-serif;
                font-size: 12px;
                margin: 20px;
            }
            h1 {
                font-size: 16px;
                margin-bottom: 5px;
            }
            .datos-paciente {
                margin-bottom: 15px;
                border-bottom: 1px solid #000;
                padding-bottom: 10px;
            }
            .datos-paciente p {
                margin: 2px 0;
            }
            table {
                width: 100%;
                border-collapse: collapse;
                margin-top: 10px;
            }
            th, td {
                border: 1px solid #000;
                padding: 5px 8px;
                text-align: left;
            }
            th {
                background-color: #f0f0f0;
            }
            .fecha {
                text-align: right;
                margin-bottom: 10px;
                font-size: 11px;
            }
            @@media print {
                .no-print { display: none; }
                body { margin: 10px; }
            }
    </style>
</head>
<body>

    <div class="no-print" style="margin-bottom: 15px;">
        <button onclick="window.print()" style="padding: 8px 16px; cursor: pointer;">🖨️ Imprimir</button>
        <button onclick="window.close()" style="padding: 8px 16px; cursor: pointer; margin-left: 10px;">✖ Cerrar</button>
    </div>

    <div class="fecha">
        Fecha de emisión: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
    </div>

    <h1>Hoja de Medicación</h1>

    <div class="datos-paciente">
        <p><strong>Paciente:</strong> @Model.Paciente.Apellido, @Model.Paciente.Nombre</p>
        <p><strong>DNI:</strong> @Model.Paciente.Dni &nbsp;&nbsp;&nbsp; <strong>Edad:</strong> @Model.Paciente.Edad años</p>
        <p><strong>Habitación:</strong> @Model.Paciente.Habitacion &nbsp;&nbsp;&nbsp; <strong>Obra Social:</strong> @Model.Paciente.ObraSocial &nbsp;&nbsp;&nbsp; <strong>Nro. Afiliado:</strong> @Model.Paciente.NroAfiliado</p>
        <p><strong>Contacto:</strong> @Model.Paciente.ContactoNombre &nbsp;&nbsp;&nbsp; <strong>Tel:</strong> @Model.Paciente.ContactoTel</p>
    </div>

    @if (!Model.Medicamentos.Any())
    {
        <p>El paciente no tiene medicamentos asignados.</p>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th>Medicamento</th>
                    <th>Presentación</th>
                    <th>Dosis</th>
                    <th>Frecuencia</th>
                    <th>Horarios</th>
                    <th>Vía</th>
                    <th>Indicación</th>
                    <th>Prescripto por</th>
                    <th>Desde</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in Model.Medicamentos)
                {
                    <tr>
                        <td>@m.NombreMedicamento</td>
                        <td>@m.Presentacion</td>
                        <td>@m.Dosis</td>
                        <td>@m.Frecuencia</td>
                        <td>@m.Horarios</td>
                        <td>@m.Via</td>
                        <td>@m.Indicacion</td>
                        <td>@m.PrescriptoPor</td>
                        <td>@m.FechaInicio.ToString("dd/MM/yyyy")</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <br />
    <p style="margin-top: 30px;">
        <strong>Firma y sello médico:</strong> ___________________________
    </p>

</body>
</html>
@model Geriatrico.Models.ViewModels.ResetPasswordViewModel

<div class="container mt-4">
    <h2>Resetear contraseña — @Model.NombreUsuario</h2>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    <form method="post">
        @Html.AntiForgeryToken()
        <input asp-for="UsuarioId" type="hidden" />
        <input asp-for="NombreUsuario" type="hidden" />

        <div class="row">
            <div class="col-md-4 mb-3">
                <label class="form-label">Nueva contraseña</label>
                <input asp-for="NuevaPassword" type="password" class="form-control" />
                <span asp-validation-for="NuevaPassword" class="text-danger"></span>
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">Confirmar contraseña</label>
                <input asp-for="ConfirmarPassword" type="password" class="form-control" />
                <span asp-validation-for="ConfirmarPassword" class="text-danger"></span>
            </div>
        </div>

        <button type="submit" class="btn btn-warning">Resetear contraseña</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>

    @section Scripts {
        <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
        <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    }
</div>
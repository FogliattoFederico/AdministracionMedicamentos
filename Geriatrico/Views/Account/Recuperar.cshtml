@{
    Layout = null;
}

@model Geriatrico.Models.ViewModels.RecuperarPasswordViewModel

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Recuperar contraseña — Geriátrico</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<body class="bg-light">
    <div class="d-flex align-items-center justify-content-center vh-100">
        <div style="width: 420px;">
            <div class="card shadow">
                <div class="card-header bg-warning text-dark text-center">
                    <h4>Geriátrico</h4>
                    <p class="mb-0">Recuperar contraseña</p>
                </div>
                <div class="card-body">

                    @if (TempData["Exito"] != null)
                    {
                        <div class="alert alert-success">@TempData["Exito"]</div>
                    }

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger">@ViewBag.Error</div>
                    }

                    <form method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label class="form-label">Email</label>
                            <input asp-for="Email" class="form-control" placeholder="admin@geriatrico.com" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Nueva contraseña</label>
                            <input asp-for="NuevaPassword" type="password" class="form-control" />
                            <span asp-validation-for="NuevaPassword" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Confirmar contraseña</label>
                            <input asp-for="ConfirmarPassword" type="password" class="form-control" />
                            <span asp-validation-for="ConfirmarPassword" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-warning w-100">Actualizar contraseña</button>
                        <a asp-action="Login" class="btn btn-secondary w-100 mt-2">Volver al login</a>
                    </form>

                </div>
            </div>
            <p class="text-center text-muted mt-3">
                <small>Esta página solo es accesible desde localhost.</small>
            </p>
        </div>
    </div>

    @section Scripts {
        <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
        <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    }
</body>
</html>